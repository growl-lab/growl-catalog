{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GROWL Catalog entry",
  "type": "object",
  "required": ["id", "title", "status", "contributors", "paper", "code", "data", "populations", "parameters"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
    "title": {"type": "string", "minLength": 5},
    "status": {"enum": ["in-progress", "ready-for-review", "complete"]},
    "contributors": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["name", "github"],
        "properties": {"name": {"type": "string"}, "github": {"type": "string"}}
      }
    },
    "paper": {
      "type": "object", "required": ["authors", "year"],
      "properties": {
        "authors": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "year": {"type": "integer", "minimum": 1950, "maximum": 2100},
        "journal": {"type": ["string", "null"]},
        "doi": {"type": ["string", "null"], "pattern": "^10\\..+/.+"},
        "arxiv": {"type": ["string", "null"]},
        "ads_bibcode": {"type": ["string", "null"]}
      },
      "anyOf": [
        {"properties": {"doi": {"type": "string"}}, "required": ["doi"]},
        {"properties": {"arxiv": {"type": "string"}}, "required": ["arxiv"]}
      ]
    },
    "code": {
      "type": "object", "required": ["name"],
      "properties": {
        "name": {"type": "string"},
        "version": {"type": ["string", "null"]},
        "url": {"type": ["string", "null"]},
        "config_files": {"type": "array", "items": {"type": "string"}}
      }
    },
    "data": {
      "type": "object", "required": ["available", "download_instructions"],
      "properties": {
        "available": {"type": "boolean"},
        "url": {"type": ["string", "null"]},
        "download_instructions": {"type": "string", "minLength": 10},
        "files": {
          "type": "array",
          "items": {"type": "object", "required": ["name"], "properties": {"name": {"type": "string"}, "description": {"type": "string"}}}
        }
      },
      "if": {"properties": {"available": {"const": true}}},
      "then": {"properties": {"url": {"type": "string", "minLength": 5}}, "required": ["url"]}
    },
    "populations": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"enum": ["BBH", "BHNS", "BNS", "other"]}
    },
    "parameters": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["name", "value", "description", "source_in_paper"],
        "properties": {
          "name": {"type": "string", "pattern": "^[a-z0-9_]+$"},
          "units": {"type": ["string", "null"]},
          "description": {"type": "string"},
          "source_in_paper": {"type": "string", "minLength": 2},
          "varied": {"type": "boolean"}
        }
      }
    },
    "model_variations": {
      "type": "array",
      "items": {"type": "object", "required": ["label"], "properties": {"label": {"type": "string"}, "description": {"type": "string"}, "changed_parameters": {"type": "object"}}}
    }
  }
}
